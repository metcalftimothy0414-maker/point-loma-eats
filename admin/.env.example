# Supabase — service role key, NOT the anon key. This app bypasses RLS
# entirely (see lib/supabase-admin.ts for why) and must never run client-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HTTP Basic Auth gate (proxy.ts) — single founder, single shared credential.
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me

# services/menu-sync's HTTP trigger endpoint (see services/menu-sync/http-server.ts).
# Powers the "Sync now" button. Not deployed anywhere yet — leave unset until it is;
# the button will fail loudly with a clear error rather than silently doing nothing.
MENU_SYNC_TRIGGER_URL=
MENU_SYNC_TRIGGER_SECRET=

# supabase/functions/refund-payment's deployed URL + shared secret. Powers
# "Issue full refund" on /orders/[id] and /refunds. Same not-deployed-yet
# situation as above — fails loudly rather than silently.
REFUND_PAYMENT_URL=
ADMIN_ACTION_SECRET=
