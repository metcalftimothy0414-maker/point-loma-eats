# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
# These are public/client-safe values (anon key is protected by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — publishable key only (client-safe by design). The secret key
# lives in the Supabase Edge Function's own env, never here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
